BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_IDS=123456789
TELEMT_API_URL=http://127.0.0.1:9091
# Must exactly match server.api.auth_header when it is configured.
TELEMT_API_AUTH=

# Optional user-facing VPN config API.
VPN_API_TOKEN=replace_with_internal_api_token
VPN_DEMO_PASSWORD=demo
VPN_SERVICE_DATA_PATH=data/vpn_service.json
VPN_DEFAULT_HOST=vpn.example.com

# VLESS Reality defaults used by the mock provider until 3x-ui integration.
VLESS_HOST=vpn.example.com
VLESS_PORT=443
VLESS_SERVER_NAME=vpn.example.com
VLESS_PUBLIC_KEY=replace-with-real-public-key
VLESS_SHORT_ID=abcd1234
VLESS_FINGERPRINT=chrome
VLESS_FLOW=xtls-rprx-vision
VLESS_NETWORK=tcp
VLESS_SECURITY=reality

# AmneziaWG defaults used by the mock provider until NodeAgent integration.
AMNEZIAWG_SERVER_PUBLIC_KEY=replace-with-real-server-key
AMNEZIAWG_ENDPOINT=vpn.example.com:51820
AMNEZIAWG_ALLOWED_IPS=0.0.0.0/0, ::/0
AMNEZIAWG_DNS=1.1.1.1
AMNEZIAWG_KEEPALIVE=25
AMNEZIAWG_CLIENT_ADDRESS=10.8.0.2/32
